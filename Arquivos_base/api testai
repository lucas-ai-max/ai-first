  "externalRef": "clickup-subtask-abc123",
  "evolutionApiUrl": "https://evo.example.com",
  "evolutionInstanceName": "tester-01",
  "evolutionApiKey": "evo-key-xxx",
  "openaiApiKey": "sk-xxx"
}
